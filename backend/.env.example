APP_NAME="URL Shortener"
APP_ENV=local
APP_KEY=
# エラー詳細を外部に出さないため既定は false。調査時のみ手元の .env で true にする
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

# 短いURLのベースURL（未設定時は APP_URL）
SHORT_URL_BASE=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ローカルの Docker Compose 用の値（compose.yaml と同じ）。本番の秘密情報ではない
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=url_shortener
DB_USERNAME=app
DB_PASSWORD=secret

# APIはセッションを使わない
SESSION_DRIVER=array

CACHE_STORE=database
QUEUE_CONNECTION=database
